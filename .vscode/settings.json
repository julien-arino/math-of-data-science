{
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.recipe.default": "rnw2pdf",
    "latex-workshop.latex.recipes": [
        {
            "name": "rnw2pdf",
            "tools": [
                "rnw2tex",
                "latexmk",
                "patchsynctex"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "rnw2tex",
            "command": "Rscript",
            "args": [
                "-e",
                "knitr::opts_knit$set(concordance = TRUE); knitr::knit('%DOC%.Rnw')"
            ]
        },
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%.tex"
            ]
        },
        {
            "name": "patchsynctex",
            "command": "Rscript",
            "args": [
                "-e",
                "patchDVI::patchSynctex('%DOC%.synctex')"
            ]
        }
    ]
}
