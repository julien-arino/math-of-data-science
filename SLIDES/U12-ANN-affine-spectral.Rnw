\SSsubsection{Multi-layer feedforward networks (MLPs) in vector and batch matrix form}

\begin{frame}{Architecture of a multi-layer feedforward network (MLP)}
\begin{center}
\begin{tikzpicture}[scale=0.82, every node/.style={transform shape}, >=Latex]
    % Input layer
    \foreach \idx/\y/\lbl in {1/2.2/x_1, 2/0.8/x_2, 3/-1.2/x_{p_0}} {
        \node[cloud, fill=blue!15, minimum width=1.2cm] (i-\idx) at (0, \y) {$\lbl$};
    }
    \node at (0, -0.1) {$\vdots$};
    \node[font=\bfseries\small, align=center] at (0, 3.3) {Input layer\\$\ba^{(0)} = \bx \in \IR^{p_0}$};

    % Hidden layer 1
    \foreach \idx/\y/\lbl in {1/2.6/a_1^{(1)}, 2/1.2/a_2^{(1)}, 3/-0.4/a_3^{(1)}, 4/-2.0/a_{p_1}^{(1)}} {
        \node[cloud, fill=yellow!25, minimum width=1.3cm] (h1-\idx) at (4.5, \y) {$\lbl$};
    }
    \node at (4.5, -1.1) {$\vdots$};
    \node[font=\bfseries\small, align=center] at (4.5, 3.6) {Hidden layer 1\\$\ba^{(1)} \in \IR^{p_1}$};

    % Hidden layer 2
    \foreach \idx/\y/\lbl in {1/2.0/a_1^{(2)}, 2/0.4/a_2^{(2)}, 3/-1.6/a_{p_2}^{(2)}} {
        \node[cloud, fill=yellow!25, minimum width=1.3cm] (h2-\idx) at (9.0, \y) {$\lbl$};
    }
    \node at (9.0, -0.5) {$\vdots$};
    \node[font=\bfseries\small, align=center] at (9.0, 3.3) {Hidden layer 2\\$\ba^{(2)} \in \IR^{p_2}$};

    % Output layer
    \foreach \idx/\y/\lbl in {1/1.2/a_1^{(L)}, 2/-0.8/a_{p_L}^{(L)}} {
        \node[cloud, fill=red!20, minimum width=1.3cm] (o-\idx) at (13.2, \y) {$\lbl$};
    }
    \node at (13.2, 0.3) {$\vdots$};
    \node[font=\bfseries\small, align=center] at (13.2, 3.3) {Output layer\\$\hat{\by} = \ba^{(L)} \in \IR^{p_L}$};

    % Edges
    \foreach \i in {1, 2, 3} {
        \foreach \j in {1, 2, 3, 4} {
            \draw[->, gray!70] (i-\i) -- (h1-\j);
        }
    }
    \foreach \j in {1, 2, 3, 4} {
        \foreach \k in {1, 2, 3} {
            \draw[->, gray!70] (h1-\j) -- (h2-\k);
        }
    }
    \foreach \k in {1, 2, 3} {
        \foreach \m in {1, 2} {
            \draw[->, gray!70] (h2-\k) -- (o-\m);
        }
    }

    \node[font=\small, text=UMbrown] at (2.25, -2.9) {$W^{(1)} \in \M_{p_1, p_0},\; \bb^{(1)} \in \IR^{p_1}$};
    \node[font=\small, text=UMbrown] at (6.75, -2.9) {$W^{(2)} \in \M_{p_2, p_1},\; \bb^{(2)} \in \IR^{p_2}$};
    \node[font=\small, text=UMbrown] at (11.1, -2.9) {$W^{(L)} \in \M_{p_L, p_{L-1}},\; \bb^{(L)} \in \IR^{p_L}$};
\end{tikzpicture}
\end{center}
\end{frame}


\begin{frame}{Single-vector formulation of an MLP layer}
\begin{importantdefinition}[Affine neural network layer -- vector form]
\label{def:mlp-vector-layer}
An $L$-layer \defword{multi-layer perceptron (MLP)} has layer widths $p_0, p_1, \ldots, p_L \in \IN_+$ (where $p_0 = p$ is the number of input features). Given a single input column vector $\ba^{(0)} = \bx \in \IR^{p_0}$, each layer $\ell \in \{1, \ldots, L\}$ maps $\ba^{(\ell-1)} \in \IR^{p_{\ell-1}}$ to $\ba^{(\ell)} \in \IR^{p_\ell}$ via
\[
\bz^{(\ell)} = W^{(\ell)} \ba^{(\ell-1)} + \bb^{(\ell)} \in \IR^{p_\ell}, \qquad
\ba^{(\ell)} = \sigma_\ell\big(\bz^{(\ell)}\big) \in \IR^{p_\ell}
\]
where:
\begin{itemize}
\item $W^{(\ell)} = \big[w_{ij}^{(\ell)}\big] \in \M_{p_\ell, p_{\ell-1}}$ is the \defword{weight matrix} of layer $\ell$ ($p_\ell$ rows for outputs, $p_{\ell-1}$ columns for inputs)
\item $\bb^{(\ell)} \in \IR^{p_\ell}$ is the \defword{bias vector} of layer $\ell$
\item $\sigma_\ell: \IR^{p_\ell} \to \IR^{p_\ell}$ is the component-wise activation function of layer $\ell$
\end{itemize}
\end{importantdefinition}
\end{frame}


\begin{frame}{From single vectors to batch matrices}
In data science (Units 04 and 05), a dataset of $n$ observations with $p_0 = p$ features is stored as a data matrix $X \in \M_{n, p_0}$ whose \textbf{rows} are transposed observation vectors (in deep learning, a subset of $n$ observations is called a \defword{batch} or \defword{mini-batch}, often denoted $B$, and $X$ is called the \defword{batch input matrix}):
\[
X = \begin{pmatrix}
\bx_1^T \\
\bx_2^T \\
\vdots \\
\bx_n^T
\end{pmatrix} \in \M_{n, p_0}
\]
\vfill
For observation $i \in \{1, \ldots, n\}$, the column vector pre-activation in layer 1 is $\bz_i^{(1)} = W^{(1)} \bx_i + \bb^{(1)} \in \IR^{p_1}$. Taking transposes to store outputs as \textbf{rows} gives:
\[
\big(\bz_i^{(1)}\big)^T = \bx_i^T \big(W^{(1)}\big)^T + \big(\bb^{(1)}\big)^T \in \M_{1, p_1}
\]
\vfill
How do we stack all $n$ rows simultaneously into a single matrix equation?
\end{frame}


\begin{frame}{Batch matrix formulation and rank-1 bias broadcasting}
\begin{importantdefinition}[Batch matrix forward propagation]
\label{def:mlp-batch-layer}
Given a data matrix (batch input matrix) $A^{(0)} = X \in \M_{n, p_0}$ whose $n$ rows are input observations, layer $\ell \in \{1, \ldots, L\}$ computes the pre-activation matrix $Z^{(\ell)} \in \M_{n, p_\ell}$ and activation matrix $A^{(\ell)} \in \M_{n, p_\ell}$ via
\[
Z^{(\ell)} = A^{(\ell-1)} \big(W^{(\ell)}\big)^T + \11_n \big(\bb^{(\ell)}\big)^T \in \M_{n, p_\ell}, \qquad
A^{(\ell)} = \sigma_\ell\big(Z^{(\ell)}\big) \in \M_{n, p_\ell}
\]
where $\11_n = (1, 1, \ldots, 1)^T \in \IR^n$ is the all-ones column vector
\end{importantdefinition}
\vfill
Why does $\11_n \big(\bb^{(\ell)}\big)^T$ appear? Because the outer product of $\11_n \in \M_{n1}$ and $\big(\bb^{(\ell)}\big)^T \in \M_{1, p_\ell}$ is a \defword{rank-1 matrix} that replicates the bias row vector across all $n$ observations:
\[
\11_n \big(\bb^{(\ell)}\big)^T =
\begin{pmatrix} 1 \\ 1 \\ \vdots \\ 1 \end{pmatrix}
\begin{pmatrix} b_1^{(\ell)} & b_2^{(\ell)} & \cdots & b_{p_\ell}^{(\ell)} \end{pmatrix}
=
\begin{pmatrix}
b_1^{(\ell)} & b_2^{(\ell)} & \cdots & b_{p_\ell}^{(\ell)} \\
b_1^{(\ell)} & b_2^{(\ell)} & \cdots & b_{p_\ell}^{(\ell)} \\
\vdots & \vdots & \ddots & \vdots \\
b_1^{(\ell)} & b_2^{(\ell)} & \cdots & b_{p_\ell}^{(\ell)}
\end{pmatrix} \in \M_{n, p_\ell}
\]
\end{frame}


\begin{frame}{Block matrix view: absorbing the bias column into $A^{(\ell-1)}$}
Just as for a single vector, we can also express the batch affine transformation as a single block matrix product by appending a column of ones $\11_n$ to $A^{(\ell-1)}$ and the bias column $\bb^{(\ell)}$ to $W^{(\ell)}$:
\[
\hat{A}^{(\ell-1)} = \big[\, A^{(\ell-1)} \;\big|\; \11_n \,\big] \in \M_{n, p_{\ell-1}+1}, \qquad
\hat{W}^{(\ell)} = \big[\, W^{(\ell)} \;\big|\; \bb^{(\ell)} \,\big] \in \M_{p_\ell, p_{\ell-1}+1}
\]
\vfill
By block matrix multiplication,
\[
\hat{A}^{(\ell-1)} \big(\hat{W}^{(\ell)}\big)^T
=
\big[\, A^{(\ell-1)} \;\big|\; \11_n \,\big]
\begin{bmatrix} \big(W^{(\ell)}\big)^T \\[3pt] \big(\bb^{(\ell)}\big)^T \end{bmatrix}
=
A^{(\ell-1)} \big(W^{(\ell)}\big)^T + \11_n \big(\bb^{(\ell)}\big)^T = Z^{(\ell)}
\]
\vfill
Both views are algebraically identical: the rank-1 outer product $\11_n \big(\bb^{(\ell)}\big)^T$ is simply the contribution of the constant column $\11_n$!
\end{frame}


\begin{frame}{Dimension tracking and parameter counting}
In software (such as R or PyTorch), shape mismatches are the most common source of bugs. Tracking dimensions systematically is essential
\vfill
\begin{proposition}[Dimension and parameter count of an $L$-layer MLP]
For a batch of $n$ observations passing through an MLP with widths $p_0, p_1, \ldots, p_L$:
\begin{itemize}
\item At layer $\ell \in \{1, \ldots, L\}$:
\[
\underbrace{A^{(\ell-1)}}_{n \times p_{\ell-1}}
\underbrace{\big(W^{(\ell)}\big)^T}_{p_{\ell-1} \times p_\ell}
+
\underbrace{\11_n}_{n \times 1}
\underbrace{\big(\bb^{(\ell)}\big)^T}_{1 \times p_\ell}
=
\underbrace{Z^{(\ell)}}_{n \times p_\ell}
\xrightarrow{\sigma_\ell}
\underbrace{A^{(\ell)}}_{n \times p_\ell}
\]
\item The total number of trainable scalar parameters (weights and biases) is
\[
P = \sum_{\ell=1}^L \big(p_\ell p_{\ell-1} + p_\ell\big) = \sum_{\ell=1}^L p_\ell\big(p_{\ell-1} + 1\big)
\]
Notice that $P$ is \textbf{independent of the number of observations $n$}
\end{itemize}
\end{proposition}
\end{frame}


\begin{frame}{Example: dimension tracking and parameter counting}
\textbf{Problem:} Consider a 3-layer MLP with input dimension $p_0 = 4$, hidden widths $p_1 = 5$ and $p_2 = 3$ and output dimension $p_3 = 2$, evaluated on a batch of $n = 10$ observations. Track all matrix dimensions and count the total number of trainable parameters
\vfill
\begin{center}
\renewcommand{\arraystretch}{1.25}
\begin{tabular}{ccccccc}
\toprule
Layer $\ell$ & $A^{(\ell-1)}$ & $W^{(\ell)}$ & $\big(W^{(\ell)}\big)^T$ & $\bb^{(\ell)}$ & $\11_n\big(\bb^{(\ell)}\big)^T$ & $Z^{(\ell)}, A^{(\ell)}$ \\
\midrule
$\ell = 1$ & $10 \times 4$ & $5 \times 4$ & $4 \times 5$ & $5 \times 1$ & $10 \times 5$ & $10 \times 5$ \\
$\ell = 2$ & $10 \times 5$ & $3 \times 5$ & $5 \times 3$ & $3 \times 1$ & $10 \times 3$ & $10 \times 3$ \\
$\ell = 3$ & $10 \times 3$ & $2 \times 3$ & $3 \times 2$ & $2 \times 1$ & $10 \times 2$ & $10 \times 2$ \\
\bottomrule
\end{tabular}
\end{center}
\vfill
\textbf{Total trainable scalar parameters:}
\begin{itemize}
\item Layer 1: $p_1 p_0 + p_1 = 5 \times 4 + 5 = 25$
\item Layer 2: $p_2 p_1 + p_2 = 3 \times 5 + 3 = 18$
\item Layer 3: $p_3 p_2 + p_3 = 2 \times 3 + 2 = 8$
\item \textbf{Total:} $P = 25 + 18 + 8 = 51$ parameters
\end{itemize}
\end{frame}


\begin{frame}{Example by hand: solving XOR with a 2-layer ReLU network}
\textbf{Problem:} Evaluate a 2-layer network ($p_0 = 2, p_1 = 2, p_2 = 1$) on all $n = 4$ points of $\{0,1\}^2$ simultaneously, with ReLU hidden activation $\sigma_1(z) = \max(0, z)$ and linear output $\sigma_2(z) = z$:
\[
X = \begin{pmatrix} 0 & 0 \\ 1 & 0 \\ 0 & 1 \\ 1 & 1 \end{pmatrix} \in \M_{42}, \quad
W^{(1)} = \begin{pmatrix} 1 & 1 \\ 1 & 1 \end{pmatrix} \in \M_{22}, \quad
\bb^{(1)} = \begin{pmatrix} 0 \\ -1 \end{pmatrix} \in \IR^2
\]
\[
W^{(2)} = \big(\bw^{(2)}\big)^T = \begin{pmatrix} 1 & -2 \end{pmatrix} \in \M_{12}, \quad
b^{(2)} = 0 \in \IR
\]
\vfill
\textbf{Step 1 -- Hidden pre-activations} $Z^{(1)} = X \big(W^{(1)}\big)^T + \11_4 \big(\bb^{(1)}\big)^T$:
\[
Z^{(1)} =
\begin{pmatrix} 0 & 0 \\ 1 & 0 \\ 0 & 1 \\ 1 & 1 \end{pmatrix}
\begin{pmatrix} 1 & 1 \\ 1 & 1 \end{pmatrix}
+
\begin{pmatrix} 1 \\ 1 \\ 1 \\ 1 \end{pmatrix}
\begin{pmatrix} 0 & -1 \end{pmatrix}
=
\begin{pmatrix} 0 & 0 \\ 1 & 1 \\ 1 & 1 \\ 2 & 2 \end{pmatrix}
+
\begin{pmatrix} 0 & -1 \\ 0 & -1 \\ 0 & -1 \\ 0 & -1 \end{pmatrix}
=
\begin{pmatrix} 0 & -1 \\ 1 & 0 \\ 1 & 0 \\ 2 & 1 \end{pmatrix}
\]
\end{frame}


\begin{frame}{Example by hand: hidden activations and output layer}
\textbf{Step 2 -- Apply ReLU entrywise} $A^{(1)} = \max\big(0, Z^{(1)}\big)$:
\[
A^{(1)} = \max\!\left(0, \begin{pmatrix} 0 & -1 \\ 1 & 0 \\ 1 & 0 \\ 2 & 1 \end{pmatrix}\right)
=
\begin{pmatrix} 0 & 0 \\ 1 & 0 \\ 1 & 0 \\ 2 & 1 \end{pmatrix} \in \M_{42}
\]
\vfill
\textbf{Step 3 -- Output layer} $\hat{\by} = Z^{(2)} = A^{(1)} \big(W^{(2)}\big)^T + \11_4 b^{(2)}$:
\[
\hat{\by} =
\begin{pmatrix} 0 & 0 \\ 1 & 0 \\ 1 & 0 \\ 2 & 1 \end{pmatrix}
\begin{pmatrix} 1 \\ -2 \end{pmatrix}
+
\begin{pmatrix} 0 \\ 0 \\ 0 \\ 0 \end{pmatrix}
=
\begin{pmatrix}
0(1) + 0(-2) \\
1(1) + 0(-2) \\
1(1) + 0(-2) \\
2(1) + 1(-2)
\end{pmatrix}
=
\begin{pmatrix} 0 \\ 1 \\ 1 \\ 0 \end{pmatrix}
\]
\vfill
The 2-layer ReLU network reproduces the exact XOR truth table on all four points!
\end{frame}


\begin{frame}{Geometric interpretation: how the hidden layer untangles XOR}
Look at the rows of the hidden activation matrix $A^{(1)}$ as coordinates in the hidden space $\IR^2$:
\[
\bx_1 = (0,0)^T \mapsto \ba_1^{(1)} = (0,0)^T, \quad
\bx_2 = (1,0)^T \text{ and } \bx_3 = (0,1)^T \mapsto (1,0)^T, \quad
\bx_4 = (1,1)^T \mapsto (2,1)^T
\]
\vfill
\begin{center}
\begin{tikzpicture}[scale=1.45, auto, >=Latex]
    % Input space
    \draw[step=1cm, gray!25, very thin] (-0.3,-0.3) grid (1.4,1.4);
    \draw[thick, ->] (-0.3,0) -- (1.6,0) node[right, font=\footnotesize] {$x_1$};
    \draw[thick, ->] (0,-0.3) -- (0,1.6) node[above, font=\footnotesize] {$x_2$};
    \node[circle, draw, very thick, fill=white, inner sep=2.2pt] at (0,0) {};
    \fill[blue!80!black] (1,0) circle[radius=2.5pt];
    \fill[blue!80!black] (0,1) circle[radius=2.5pt];
    \node[circle, draw, very thick, fill=white, inner sep=2.2pt] at (1,1) {};
    \node[font=\footnotesize\bfseries] at (0.6, -0.5) {Input space $\bx \in \IR^2$};

    % Arrow
    \draw[->, ultra thick, UMbrown] (2.1, 0.6) -- node[above, font=\footnotesize\bfseries] {$\bx \mapsto \operatorname{ReLU}(W^{(1)}\bx+\bb^{(1)})$} (4.1, 0.6);

    % Hidden space
    \begin{scope}[xshift=4.8cm]
        \draw[step=1cm, gray!25, very thin] (-0.3,-0.3) grid (2.3,1.4);
        \draw[thick, ->] (-0.3,0) -- (2.5,0) node[right, font=\footnotesize] {$a_1^{(1)}$};
        \draw[thick, ->] (0,-0.3) -- (0,1.6) node[above, font=\footnotesize] {$a_2^{(1)}$};
        \draw[very thick, red!80!black, dashed] (0.5, -0.1) -- (2.3, 0.8) node[above, font=\scriptsize] {$a_1^{(1)} - 2a_2^{(1)} = 0.5$};
        \node[circle, draw, very thick, fill=white, inner sep=2.2pt] at (0,0) {};
        \fill[blue!80!black] (1,0) circle[radius=2.8pt] node[below=3pt, font=\scriptsize] {$(1,0)$};
        \node[circle, draw, very thick, fill=white, inner sep=2.2pt] at (2,1) {};
        \node[font=\footnotesize\bfseries] at (1.0, -0.5) {Hidden space $\ba^{(1)} \in \IR^2$ (separable!)};
    \end{scope}
\end{tikzpicture}
\end{center}
\end{frame}


\begin{frame}[fragile]{Verification in R: batch matrix forward pass for XOR}
<<xor-batch-forward>>=
X = matrix(c(0, 0,  1, 0,  0, 1,  1, 1), nrow = 4, byrow = TRUE)
W1 = matrix(c(1, 1,  1, 1), nrow = 2, byrow = TRUE)
b1 = c(0, -1);  one_n = rep(1, nrow(X))
Z1 = X %*% t(W1) + one_n %*% t(b1)
A1 = pmax(0, Z1)
y_hat = A1 %*% c(1, -2)
cbind(X, A1 = A1, y_hat = as.vector(y_hat))
@
\end{frame}


