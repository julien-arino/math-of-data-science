%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
\SSsection{Why non-linearity is essential: collapsing linear networks}

\begin{frame}{What if all activation functions are linear?}
Suppose we build a deep neural network with $L$ layers, but we omit the non-linear activations by setting every activation function to the identity map:
\[
\sigma_\ell(\bz) = \bz \qquad \forall \ell \in \{1, \ldots, L\}
\]
Such an architecture is called a \defword{deep linear network}
\vfill
At each layer $\ell$, the transformation is purely affine:
\[
\ba^{(\ell)} = W^{(\ell)} \ba^{(\ell-1)} + \bb^{(\ell)}
\]
\vfill
What is the expressive power of composing $L$ affine transformations in sequence?
\end{frame}


\begin{frame}{Collapse of composed affine maps}
\begin{importanttheorem}[Collapse of deep linear networks]
\label{th:affine-collapse}
Let $f_\ell(\bu) = W^{(\ell)} \bu + \bb^{(\ell)}$ be affine maps with $W^{(\ell)} \in \M_{p_\ell, p_{\ell-1}}$ and $\bb^{(\ell)} \in \IR^{p_\ell}$ for $\ell = 1, \ldots, L$. Their composition $f = f_L \circ f_{L-1} \circ \cdots \circ f_1 : \IR^{p_0} \to \IR^{p_L}$ is a \textbf{single affine map}
\[
f(\bx) = W \bx + \bb
\]
where the effective weight matrix $W \in \M_{p_L, p_0}$ and effective bias $\bb \in \IR^{p_L}$ are given by
\[
W = W^{(L)} W^{(L-1)} \cdots W^{(1)}, \qquad
\bb = \sum_{\ell=1}^{L-1} \left(W^{(L)} \cdots W^{(\ell+1)}\right) \bb^{(\ell)} + \bb^{(L)}
\]
\end{importanttheorem}
\vfill
In batch matrix form on $X \in \M_{n, p_0}$, the $L$-layer linear network collapses to
\[
A^{(L)} = X W^T + \11_n \bb^T
\]
\end{frame}


\begin{frame}[red]{Proof of Theorem \ref{th:affine-collapse} (collapse of composed affine maps)}
We proceed by induction on the number of layers $L \ge 1$
\vfill
\textbf{Base case ($L = 2$):} For two layers, substituting $\ba^{(1)} = W^{(1)} \bx + \bb^{(1)}$ into layer 2 gives
\begin{align*}
\ba^{(2)} &= W^{(2)} \ba^{(1)} + \bb^{(2)} \\
&= W^{(2)}\big(W^{(1)} \bx + \bb^{(1)}\big) + \bb^{(2)} \\
&= \big(W^{(2)} W^{(1)}\big) \bx + \big(W^{(2)} \bb^{(1)} + \bb^{(2)}\big)
\end{align*}
which is a single affine map with $W = W^{(2)} W^{(1)}$ and $\bb = W^{(2)} \bb^{(1)} + \bb^{(2)}$
\vfill
\textbf{Inductive step:} Suppose after $L-1$ layers that $\ba^{(L-1)} = \widetilde{W} \bx + \tilde{\bb}$ with $\widetilde{W} = W^{(L-1)} \cdots W^{(1)}$. Applying layer $L$ yields
\[
\ba^{(L)} = W^{(L)}\big(\widetilde{W} \bx + \tilde{\bb}\big) + \bb^{(L)}
= \big(W^{(L)} \widetilde{W}\big) \bx + \big(W^{(L)} \tilde{\bb} + \bb^{(L)}\big) = W \bx + \bb \qed
\]
\end{frame}


\begin{frame}{Rank bottleneck bound for deep linear networks}
Not only does a deep linear network collapse into a single matrix $W = W^{(L)} \cdots W^{(1)}$, the rank of $W$ is choked by the narrowest layer in the network
\vfill
\begin{importanttheorem}[Rank bottleneck bound]
\label{th:rank-bottleneck}
Let $W = W^{(L)} W^{(L-1)} \cdots W^{(1)} \in \M_{p_L, p_0}$ with $W^{(\ell)} \in \M_{p_\ell, p_{\ell-1}}$ for $\ell = 1, \ldots, L$. Then
\[
\rank(W) \le \min_{1 \le \ell \le L} \rank\big(W^{(\ell)}\big) \le \min_{0 \le \ell \le L} p_\ell
\]
\end{importanttheorem}
\vfill
Before proving Theorem~\ref{th:rank-bottleneck}, recall the fundamental definitions for $M \in \M_{np}$:
\[
\range(M) = \big\{ M\bx : \bx \in \IR^p \big\} \subseteq \IR^n, \qquad
\nullspace(M) = \big\{ \bx \in \IR^p : M\bx = \b0 \big\} \subseteq \IR^p
\]
and the \textbf{rank-nullity theorem}: $\rank(M) + \nullity(M) = \dim\range(M) + \dim\nullspace(M) = p$
\end{frame}


\begin{frame}[red]{Proof of Theorem \ref{th:rank-bottleneck} -- part 1: subspace inclusions}
Let $A \in \M_{np}$ and $B \in \M_{pq}$ so that $AB \in \M_{nq}$. We prove two fundamental inclusions:
\vfill
\begin{enumerate}
\item \textbf{Range inclusion} $\range(AB) \subseteq \range(A)$:
Let $\by \in \range(AB)$. Then there exists $\bx \in \IR^q$ such that
\[
\by = (AB)\bx = A(B\bx)
\]
Setting $\bu = B\bx \in \IR^p$, we have $\by = A\bu \in \range(A)$. Thus $\range(AB) \subseteq \range(A)$, which implies
\[
\rank(AB) = \dim\range(AB) \le \dim\range(A) = \rank(A)
\]
\vfill
\item \textbf{Nullspace inclusion} $\nullspace(B) \subseteq \nullspace(AB)$:
Let $\bx \in \nullspace(B)$, so $B\bx = \b0$. Multiplying on the left by $A$ gives
\[
(AB)\bx = A(B\bx) = A\b0 = \b0 \implies \bx \in \nullspace(AB)
\]
Thus $\nullspace(B) \subseteq \nullspace(AB)$, so $\nullity(B) \le \nullity(AB)$
\end{enumerate}
\end{frame}


\begin{frame}[red]{Proof of Theorem \ref{th:rank-bottleneck} -- part 2: rank of a matrix product}
\begin{enumerate}
\setcounter{enumi}{2}
\item \textbf{Combining with the rank-nullity theorem}:
Since $B \in \M_{pq}$ and $AB \in \M_{nq}$ both have $q$ columns, the rank-nullity theorem gives
\[
\rank(AB) = q - \nullity(AB) \le q - \nullity(B) = \rank(B)
\]
Combining parts 1 and 2 yields the fundamental inequality for any compatible matrices $A$ and $B$:
\[
\rank(AB) \le \min\big(\rank(A), \rank(B)\big)
\]
\vfill
\item \textbf{Induction over $L$ layers}:
Applying $\rank(AB) \le \min(\rank(A), \rank(B))$ inductively to $W = W^{(L)} W^{(L-1)} \cdots W^{(1)}$ gives
\[
\rank(W) \le \min_{1 \le \ell \le L} \rank\big(W^{(\ell)}\big)
\]
Finally, since $W^{(\ell)} \in \M_{p_\ell, p_{\ell-1}}$, its rank cannot exceed its number of rows $p_\ell$ or columns $p_{\ell-1}$, so $\rank(W^{(\ell)}) \le \min(p_\ell, p_{\ell-1})$, which gives $\rank(W) \le \min_{0 \le \ell \le L} p_\ell \qed$
\end{enumerate}
\end{frame}


\begin{frame}{Consequences of linear collapse and the rank bottleneck}
Theorem~\ref{th:affine-collapse} and Theorem~\ref{th:rank-bottleneck} reveal two critical design principles of neural networks:
\vfill
\begin{enumerate}
\item \textbf{Depth without non-linearity is futile}:
A 100-layer linear network cannot represent any function that a single 1-layer affine map $f(\bx) = W\bx + \bb$ cannot already represent. In particular, a 100-layer linear network \textbf{still cannot solve XOR}!
\vfill
\item \textbf{Narrow hidden layers create permanent rank bottlenecks}:
Suppose a 3-layer linear network has architecture $\IR^{10} \xrightarrow{W^{(1)}} \IR^2 \xrightarrow{W^{(2)}} \IR^{50} \xrightarrow{W^{(3)}} \IR^{10}$. Even though layer 2 expands to 50 neurons and the output has dimension 10,
\[
\rank\big(W^{(3)} W^{(2)} W^{(1)}\big) \le \min(10, 2, 50, 10) = 2
\]
Every output vector $f(\bx)$ is confined to at most a $2$-dimensional affine subspace of $\IR^{10}$!
\end{enumerate}
\vfill
Non-linear activations $\sigma_\ell$ bend the coordinate hyperplanes at each layer, allowing the network to construct piecewise-linear (for ReLU) or smooth non-linear decision boundaries
\end{frame}


\begin{frame}{Example by hand: collapsing a 2-layer linear network}
\textbf{Problem:} Consider a 2-layer linear network mapping $\IR^3 \to \IR^2 \to \IR^3$ ($\sigma_1 = \sigma_2 = \text{id}$) with
\[
W^{(1)} = \begin{pmatrix} 1 & 2 & -1 \\ 0 & 1 & 1 \end{pmatrix}, \quad
\bb^{(1)} = \begin{pmatrix} 1 \\ -1 \end{pmatrix}, \quad
W^{(2)} = \begin{pmatrix} 2 & 1 \\ -1 & 0 \\ 1 & 1 \end{pmatrix}, \quad
\bb^{(2)} = \begin{pmatrix} 0 \\ 2 \\ 1 \end{pmatrix}
\]
Find the collapsed affine map $f(\bx) = W\bx + \bb$ and determine $\rank(W)$
\vfill
\textbf{Solution:} By Theorem~\ref{th:affine-collapse},
\[
W = W^{(2)} W^{(1)} =
\begin{pmatrix} 2 & 1 \\ -1 & 0 \\ 1 & 1 \end{pmatrix}
\begin{pmatrix} 1 & 2 & -1 \\ 0 & 1 & 1 \end{pmatrix}
=
\begin{pmatrix} 2 & 5 & -1 \\ -1 & -2 & 1 \\ 1 & 3 & 0 \end{pmatrix}, \quad
\bb = W^{(2)} \bb^{(1)} + \bb^{(2)} =
\begin{pmatrix} 1 \\ -1 \\ 0 \end{pmatrix}
+
\begin{pmatrix} 0 \\ 2 \\ 1 \end{pmatrix}
=
\begin{pmatrix} 1 \\ 1 \\ 1 \end{pmatrix}
\]
\end{frame}


\begin{frame}{Example by hand: verifying the rank bottleneck}
Although $W \in \M_3$ is a $3 \times 3$ matrix, Theorem~\ref{th:rank-bottleneck} guarantees that because the hidden layer has width $p_1 = 2$,
\[
\rank(W) \le \min(3, 2, 3) = 2 < 3
\]
so $W$ \textbf{cannot be invertible} ($\det(W) = 0$)
\vfill
Indeed, inspecting the rows $R_1, R_2, R_3$ of $W = \begin{pmatrix} 2 & 5 & -1 \\ -1 & -2 & 1 \\ 1 & 3 & 0 \end{pmatrix}$, we see that
\[
R_1 + R_2 = (2 - 1, \; 5 - 2, \; -1 + 1) = (1, 3, 0) = R_3
\]
Since $R_1$ and $R_2$ are not scalar multiples of each other, $\rank(W) = 2$
\vfill
\textbf{How ReLU breaks the rank bound}: In our XOR example, the pre-activation matrix $Z^{(1)} = \begin{pmatrix} 0 & -1 \\ 1 & 0 \\ 1 & 0 \\ 2 & 1 \end{pmatrix}$ had column 2 equal to $(\text{column } 1) - \11_4$, so no linear combination with $\11_4$ could yield $\by = (0, 1, 1, 0)^T$. Applying $\operatorname{ReLU}$ zeroed out only the $-1$ entry in row 1, producing $A^{(1)} = \begin{pmatrix} 0 & 0 \\ 1 & 0 \\ 1 & 0 \\ 2 & 1 \end{pmatrix}$ whose columns span $\by$!
\end{frame}


%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
\SSsection{Linear autoencoders and subspace projections (bridge to PCA)}

\begin{frame}{When a rank bottleneck is a feature, not a bug!}
In supervised classification, an unintended rank bottleneck restricts the expressive power of a linear network
\vfill
In \defword{unsupervised representation learning} and \defword{dimensionality reduction} (Units 04 and 05), however, we \textbf{deliberately} introduce a narrow hidden layer of width $k < p$ to force the network to compress $p$-dimensional data into $k$ latent coordinates!
\vfill
\begin{center}
\begin{tikzpicture}[scale=0.85, every node/.style={transform shape}, >=Latex]
    % Input
    \draw[fill=blue!15, thick] (0, -1.6) rectangle (1.1, 1.6);
    \node[align=center, font=\small\bfseries] at (0.55, 0) {$\bx \in \IR^p$};
    \node[font=\footnotesize] at (0.55, -2.0) {Input ($p$)};

    % Bottleneck
    \draw[fill=orange!25, thick] (4.8, -0.7) rectangle (5.9, 0.7);
    \node[align=center, font=\small\bfseries] at (5.35, 0) {$\bz \in \IR^k$};
    \node[font=\footnotesize] at (5.35, -1.2) {Bottleneck ($k < p$)};

    % Output
    \draw[fill=green!15, thick] (9.6, -1.6) rectangle (10.7, 1.6);
    \node[align=center, font=\small\bfseries] at (10.15, 0) {$\hat{\bx} \in \IR^p$};
    \node[font=\footnotesize] at (10.15, -2.0) {Reconstruction ($p$)};

    % Trapezoid lines
    \draw[->, very thick, UMbrown] (1.2, 0.5) -- node[above, sloped, font=\small\bfseries] {Encoder $W_1 \in \M_{pk}$} (4.7, 0.25);
    \draw[->, very thick, UMbrown] (1.2, -0.5) -- (4.7, -0.25);

    \draw[->, very thick, UMbrown] (6.0, 0.25) -- node[above, sloped, font=\small\bfseries] {Decoder $W_2 \in \M_{kp}$} (9.5, 0.5);
    \draw[->, very thick, UMbrown] (6.0, -0.25) -- (9.5, -0.5);
\end{tikzpicture}
\end{center}
\end{frame}


\begin{frame}{Linear autoencoders}
\begin{importantdefinition}[Linear autoencoder]
\label{def:linear-autoencoder}
Let $\widetilde{X} = C_n X \in \M_{np}$ be a centred data matrix ($n$ observations in $\IR^p$, column means zero) and let $1 \le k < p$ be the bottleneck dimension. A \defword{linear autoencoder} consists of:
\begin{enumerate}
\item An \defword{encoder matrix} $W_1 \in \M_{pk}$ mapping data to a low-dimensional \defword{latent code}
\[
Z = \widetilde{X} W_1 \in \M_{nk}
\]
\item A \defword{decoder matrix} $W_2 \in \M_{kp}$ mapping the latent code back to a reconstruction
\[
\hat{X} = Z W_2 = \widetilde{X} W_1 W_2 \in \M_{np}
\]
\end{enumerate}
The autoencoder is trained to minimise the squared Frobenius reconstruction error:
\[
\min_{W_1 \in \M_{pk},\; W_2 \in \M_{kp}} \|\widetilde{X} - \widetilde{X} W_1 W_2\|_F^2
= \min_{W_1 \in \M_{pk},\; W_2 \in \M_{kp}} \sum_{i=1}^n \big\|\tilde{\bx}_i - W_2^T W_1^T \tilde{\bx}_i\big\|_2^2
\]
\end{importantdefinition}
\end{frame}


\begin{frame}{Bridge to SVD (Unit 04) and PCA (Unit 05)}
Let us connect the linear autoencoder problem directly to the Eckart-Young theorem (Unit 04) and principal component analysis (Unit 05)
\vfill
\begin{itemize}
\item Recall that the centred data matrix $\widetilde{X} \in \M_{np}$ has singular value decomposition
\[
\widetilde{X} = U \Sigma V^T = \sum_{j=1}^r \sigma_j \bu_j \bv_j^T, \qquad \sigma_1 \ge \sigma_2 \ge \cdots \ge \sigma_r > 0
\]
where the right singular vectors $\bv_1, \ldots, \bv_p \in \IR^p$ are the orthonormal eigenvectors of the sample covariance matrix $S_X = \frac{1}{n-1} \widetilde{X}^T \widetilde{X}$ (\ie, the \textbf{principal axes})
\vfill
\item Let $V_k = [\bv_1, \ldots, \bv_k] \in \M_{pk}$ collect the top $k$ principal axes. In Unit 05, the rank-$k$ PCA reconstruction of $\widetilde{X}$ was shown to be
\[
\widetilde{X}_k = U_k \Sigma_k V_k^T = (\widetilde{X} V_k) V_k^T = \widetilde{X} \big(V_k V_k^T\big)
\]
where $P_k = V_k V_k^T \in \M_p$ is the \defword{orthogonal projector} onto $\Span\{\bv_1, \ldots, \bv_k\}$
\end{itemize}
\end{frame}


\begin{frame}{Optimal linear autoencoders recover the PCA subspace}
\begin{importanttheorem}[Baldi and Hornik, 1989 -- Eckart-Young corollary]
\label{th:baldi-hornik}
Let $\widetilde{X} \in \M_{np}$ have singular values $\sigma_1 \ge \cdots \ge \sigma_p \ge 0$ and right singular vectors $V = [\bv_1, \ldots, \bv_p] \in \M_p$. For any $k < \rank(\widetilde{X})$, consider
\[
\min_{W_1 \in \M_{pk},\; W_2 \in \M_{kp}} \|\widetilde{X} - \widetilde{X} W_1 W_2\|_F^2
\]
\begin{enumerate}
\item The minimum reconstruction error is $\displaystyle \sum_{j=k+1}^p \sigma_j^2$
\item When $\sigma_k > \sigma_{k+1}$, the global minimum on $\range(\widetilde{X}^T)$ is achieved when
\[
P = W_1 W_2 = V_k V_k^T
\]
is the orthogonal projection matrix onto the top-$k$ principal subspace $\Span\{\bv_1, \ldots, \bv_k\}$, achieved by
\[
W_1 = V_k C, \qquad W_2 = C^{-1} V_k^T \qquad \text{for any invertible } C \in \GL_k(\IR)
\]
\end{enumerate}
\end{importanttheorem}
\end{frame}


\begin{frame}[red]{Proof of Theorem \ref{th:baldi-hornik} (Baldi-Hornik / Eckart-Young corollary)}
\begin{enumerate}
\item \textbf{Lower bound via the rank bottleneck bound and Eckart-Young}:
For any $W_1 \in \M_{pk}$ and $W_2 \in \M_{kp}$, Theorem~\ref{th:rank-bottleneck} implies
\[
\rank(W_1 W_2) \le \min(p, k, p) = k \implies \rank(\widetilde{X} W_1 W_2) \le \rank(W_1 W_2) \le k
\]
Hence $\hat{X} = \widetilde{X} W_1 W_2 \in \M_{np}$ is a matrix of rank at most $k$. By the Eckart-Young theorem (Unit 04), the best rank-$k$ approximation to $\widetilde{X}$ in the Frobenius norm is the truncated SVD $\widetilde{X}_k = U_k \Sigma_k V_k^T$, so for all $W_1, W_2$:
\[
\|\widetilde{X} - \widetilde{X} W_1 W_2\|_F^2 \ge \|\widetilde{X} - \widetilde{X}_k\|_F^2 = \sum_{j=k+1}^p \sigma_j^2
\]
\vfill
\item \textbf{Attaining the bound}:
Let $C \in \GL_k(\IR)$ be any invertible $k \times k$ matrix and set $W_1 = V_k C \in \M_{pk}$ and $W_2 = C^{-1} V_k^T \in \M_{kp}$. Then
\[
W_1 W_2 = (V_k C)(C^{-1} V_k^T) = V_k (C C^{-1}) V_k^T = V_k \II_k V_k^T = V_k V_k^T
\]
Since $\widetilde{X} V_k = U \Sigma V^T V_k = U_k \Sigma_k$, we obtain $\widetilde{X} W_1 W_2 = \widetilde{X} V_k V_k^T = U_k \Sigma_k V_k^T = \widetilde{X}_k$, achieving the exact Eckart-Young minimum $\sum_{j=k+1}^p \sigma_j^2 \qed$
\end{enumerate}
\end{frame}


\begin{frame}{Subspace equivalence vs basis non-uniqueness}
Notice a subtle and important distinction in Theorem~\ref{th:baldi-hornik}:
\vfill
\begin{itemize}
\item \textbf{What is unique}: The product $P = W_1 W_2 = V_k V_k^T \in \M_p$ is the unique orthogonal projector onto the $k$-dimensional principal subspace $\S_k = \Span\{\bv_1, \ldots, \bv_k\}$ (satisfying $P^2 = P$ and $P^T = P$)
\vfill
\item \textbf{What is not unique (gauge freedom)}: Because $W_1 = V_k C$ and $W_2 = C^{-1} V_k^T$ give the exact same product $W_1 W_2 = V_k V_k^T$ for \textbf{any} invertible $C \in \GL_k(\IR)$, a linear autoencoder without extra constraints learns a basis for the principal subspace $\S_k$, not necessarily the orthogonal principal axes $V_k$ themselves
\vfill
\item \textbf{PCA corresponds to choosing $C = \II_k$}: Setting $W_1 = V_k$ and $W_2 = V_k^T$ imposes the orthogonality constraint $W_1^T W_1 = \II_k$ and ties the decoder weights to the transpose of the encoder ($W_2 = W_1^T$)
\end{itemize}
\end{frame}


\begin{frame}{Orthogonal projector properties and Pythagorean error decomposition}
Let us verify that $P_k = V_k V_k^T \in \M_p$ is an \defword{orthogonal projection matrix}:
\begin{itemize}
\item \textbf{Symmetric}: $P_k^T = \big(V_k V_k^T\big)^T = \big(V_k^T\big)^T V_k^T = V_k V_k^T = P_k$
\item \textbf{Idempotent}: Since the columns of $V_k$ are orthonormal ($V_k^T V_k = \II_k$),
\[
P_k^2 = \big(V_k V_k^T\big)\big(V_k V_k^T\big) = V_k \big(V_k^T V_k\big) V_k^T = V_k \II_k V_k^T = P_k
\]
\end{itemize}
\vfill
Every centred data matrix $\widetilde{X} \in \M_{np}$ decomposes into two mutually orthogonal components:
\[
\widetilde{X} = \underbrace{\widetilde{X} P_k}_{\text{projection onto } \S_k} + \underbrace{\widetilde{X} (\II_p - P_k)}_{\text{residual in } \S_k^\perp}
\]
Because $P_k(\II_p - P_k) = P_k - P_k^2 = 0$, the squared Frobenius norm splits by Pythagoras:
\[
\|\widetilde{X} - \widetilde{X} P_k\|_F^2 = \|\widetilde{X}\|_F^2 - \|\widetilde{X} P_k\|_F^2 = \sum_{j=1}^p \sigma_j^2 - \sum_{j=1}^k \sigma_j^2 = \sum_{j=k+1}^p \sigma_j^2
\]
\end{frame}


\begin{frame}{Example by hand: rank-1 linear autoencoder vs PCA}
Consider the centred $4 \times 2$ data matrix $\widetilde{X} \in \M_{42}$ and bottleneck dimension $k = 1$:
\[
\widetilde{X} = \begin{pmatrix} 3 & 4 \\ -3 & -4 \\ 3 & 4 \\ -3 & -4 \end{pmatrix}, \qquad
\widetilde{X}^T \widetilde{X} = \begin{pmatrix} 36 & 48 \\ 48 & 64 \end{pmatrix} = 100 \begin{pmatrix} 0.36 & 0.48 \\ 0.48 & 0.64 \end{pmatrix}
\]
\vfill
\begin{itemize}
\item The unit eigenvector of $\widetilde{X}^T \widetilde{X}$ for $\lambda_1 = \sigma_1^2 = 100$ is $\bv_1 = \begin{pmatrix} 0.6 \\ 0.8 \end{pmatrix}$ (and $\sigma_2^2 = 0$ for $\bv_2 = \begin{pmatrix} -0.8 \\ 0.6 \end{pmatrix}$)
\item The PCA choice ($C = 1$) uses $W_1 = \bv_1 = \begin{pmatrix} 0.6 \\ 0.8 \end{pmatrix}$ and $W_2 = \bv_1^T = \begin{pmatrix} 0.6 & 0.8 \end{pmatrix}$
\item Any scaled pair $\widetilde{W}_1 = c \bv_1 = \begin{pmatrix} 1.2 \\ 1.6 \end{pmatrix}$ and $\widetilde{W}_2 = c^{-1} \bv_1^T = \begin{pmatrix} 0.3 & 0.4 \end{pmatrix}$ (with $c = 2$) gives the \textbf{exact same orthogonal projector}:
\[
P = W_1 W_2 = \widetilde{W}_1 \widetilde{W}_2 = \bv_1 \bv_1^T = \begin{pmatrix} 0.36 & 0.48 \\ 0.48 & 0.64 \end{pmatrix}, \qquad \hat{X} = \widetilde{X} P = \widetilde{X}
\]
\end{itemize}
\end{frame}


\begin{frame}[fragile]{R demonstration: training a linear autoencoder recovers PCA}
Generate a centred 3D dataset ($n = 150, p = 3$) and train a linear autoencoder ($k = 2$) by minimising $\|\widetilde{X} - \widetilde{X} W_1 W_2\|_F^2$ from random initial weights:
<<linear-autoencoder-pca>>=
set.seed(2740); n = 150; p = 3; k = 2
M_mix = matrix(c(3, 2, 1, 0, 1.5, 1, 0, 0, 0.3), nrow = 3, byrow = TRUE)
X_tilde = scale(matrix(rnorm(n * p), n, p) %*% M_mix, center = TRUE, scale = FALSE)
V_k = svd(X_tilde)$v[, 1:k];  P_pca = V_k %*% t(V_k)

ae_loss = function(th) {
  W1 = matrix(th[1:6], p, k);  W2 = matrix(th[7:12], k, p)
  sum((X_tilde - X_tilde %*% W1 %*% W2)^2)
}
opt = optim(rnorm(12, sd = 0.5), ae_loss, method = "BFGS",
            control = list(maxit = 500, reltol = 1e-12))
W1_hat = matrix(opt$par[1:6], p, k);  W2_hat = matrix(opt$par[7:12], k, p)
P_ae = W1_hat %*% W2_hat
@
\end{frame}


\begin{frame}[fragile]{Comparing the learned projector $W_1 W_2$ with $V_k V_k^T$}
Even though $W_1$ and $V_k$ differ by an invertible change of basis $C \in \GL_2(\IR)$, their product $W_1 W_2$ matches the orthogonal PCA projector $V_k V_k^T$ to high precision:
<<linear-autoencoder-compare>>=
round(P_pca, 4)
round(P_ae, 4)
max(abs(P_pca - P_ae))
@
\end{frame}


<<plot-ae-pca,echo=FALSE,fig.width=7.5,fig.height=4.2>>=
X_pca = X_tilde %*% P_pca
X_ae = X_tilde %*% P_ae
par(mfrow = c(1, 2), mar = c(4, 4, 2.5, 1), mgp = c(2.2, 0.7, 0))
plot(X_tilde[, 1], X_tilde[, 2], pch = 19, col = "gray70",
     xlab = "Feature 1 (centred)", ylab = "Feature 2 (centred)",
     main = "PCA vs Autoencoder reconstruction (x1, x2)")
points(X_pca[, 1], X_pca[, 2], pch = 1, col = "dodgerblue4", cex = 1.3, lwd = 1.5)
points(X_ae[, 1], X_ae[, 2], pch = 4, col = "firebrick", cex = 1.1, lwd = 1.5)
legend("topleft", legend = c("Original 3D data", "PCA (X_tilde V_k V_k^T)", "Autoencoder (X_tilde W_1 W_2)"),
       col = c("gray70", "dodgerblue4", "firebrick"), pch = c(19, 1, 4), bty = "n", cex = 0.85)

# Latent space comparison
Z_pca = X_tilde %*% V_k
Z_ae = X_tilde %*% W1_hat
# Align Z_ae to Z_pca via C = (V_k^T W1_hat)^{-1}
C_mat = t(V_k) %*% W1_hat
Z_ae_aligned = Z_ae %*% solve(C_mat)
plot(Z_pca[, 1], Z_pca[, 2], pch = 1, col = "dodgerblue4", cex = 1.3, lwd = 1.5,
     xlab = "Principal coordinate 1", ylab = "Principal coordinate 2",
     main = "Latent code after basis alignment C^{-1}")
points(Z_ae_aligned[, 1], Z_ae_aligned[, 2], pch = 4, col = "firebrick", cex = 1.1, lwd = 1.5)
legend("topleft", legend = c("PCA scores Z = X_tilde V_k", "Aligned AE code Z_AE C^{-1}"),
       col = c("dodgerblue4", "firebrick"), pch = c(1, 4), bty = "n", cex = 0.85)
@

\maxFrameImage{\Sexpr{knitr::fig_chunk("plot-ae-pca", "pdf")}}


%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
\SSsection{Graph convolutional networks: combining left and right matrix multiplication}

%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
\SSsubsection{Left-multiplication vs right-multiplication on X}

\begin{frame}{What when the rows of $X$ are connected by a graph?}
In a standard MLP or autoencoder, the rows of $X \in \M_{np}$ are treated as independent observations
\vfill
In many applications (Units 08 to 10), however, the $n$ rows of $X \in \M_{np}$ are the \textbf{vertices of a graph} $G = (V, E)$ with adjacency matrix $A \in \M_n$ (in graph machine learning, the data matrix $X$ is called the \defword{vertex feature matrix} or \defword{node feature matrix}):
\begin{itemize}
\item \textbf{Citation networks}: vertices are scientific papers, rows $\bx_i^T \in \IR^p$ are word-frequency vectors and edges are citations
\item \textbf{Social and epidemiological networks}: vertices are individuals or cities, features are demographic variables and edges are contact or mobility links
\item \textbf{Molecular graphs}: vertices are atoms, features are atomic properties and edges are chemical bonds
\end{itemize}
\vfill
How can a neural network layer use \textbf{both} the vertex features $X \in \M_{np}$ and the graph structure $A \in \M_n$?
\end{frame}


\begin{frame}{The fundamental linear algebra duality: left vs right multiplication}
Given a data matrix (vertex feature matrix) $X \in \M_{np}$ ($n$ vertices in rows, $p$ features in columns), consider what happens when we multiply $X$ on the \textbf{right} versus on the \textbf{left}:
\vfill
\begin{importantproperty}[Right-multiplication mixes features; left-multiplication mixes vertices]
\label{prop:left-vs-right}
Let $X \in \M_{np}$ have rows $\bx_1^T, \ldots, \bx_n^T \in \IR^{1 \times p}$ and columns $\bc_1, \ldots, \bc_p \in \IR^n$:
\begin{enumerate}
\item \textbf{Right-multiplication by a weight matrix $W \in \M_{pq}$}:
\[
(XW)_{i\bullet} = \bx_i^T W \in \IR^{1 \times q} \qquad (i = 1, \ldots, n)
\]
Each vertex $i$ transforms its \textbf{own features} independently of all other vertices (this is a standard MLP layer, completely ignoring the graph $G$)
\item \textbf{Left-multiplication by a graph operator $S \in \M_n$}:
\[
(SX)_{i\bullet} = \sum_{j=1}^n s_{ij} \bx_j^T \in \IR^{1 \times p} \qquad (i = 1, \ldots, n)
\]
Each vertex $i$ forms a linear combination of the \textbf{feature vectors of neighbouring vertices} across the graph!
\end{enumerate}
\end{importantproperty}
\end{frame}


\begin{frame}{Visualising the two-sided sandwich product $S X W$}
Combining left-multiplication by a graph operator $S \in \M_n$ and right-multiplication by a feature weight matrix $W \in \M_{pq}$ produces the \defword{sandwich product} $S X W \in \M_{nq}$:
\vfill
\[
\underbrace{S}_{\substack{n \times n \\ \text{mixes rows} \\ \text{(graph neighbours)}}}
\;\;
\underbrace{X}_{\substack{n \times p \\ \text{vertex features} \\ \text{(data matrix)}}}
\;\;
\underbrace{W}_{\substack{p \times q \\ \text{mixes columns} \\ \text{(trainable weights)}}}
\;=\;
\underbrace{Z}_{\substack{n \times q \\ \text{updated vertex} \\ \text{representations}}}
\]
\vfill
By associativity of matrix multiplication, $(SX)W = S(XW)$:
\begin{itemize}
\item Viewing it as $(SX)W$: first \textbf{aggregate/smooth features} across graph neighbours ($SX \in \M_{np}$), then \textbf{project features} using trainable weights $W$
\item Viewing it as $S(XW)$: first \textbf{project each vertex's features} into $\IR^q$ ($XW \in \M_{nq}$), then \textbf{aggregate the projected vectors} across graph neighbours via $S$
\end{itemize}
\end{frame}


%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
\SSsubsection{Self-loops, degree normalisation and the GCN layer}

\begin{frame}{Why raw adjacency multiplication $AX$ has two flaws}
Suppose we set $S = A$, where $A = [a_{ij}] \in \M_n$ is the unweighted adjacency matrix of an undirected simple graph $G$ ($a_{ij} = 1$ if $i \sim j$ and $0$ otherwise). Then row $i$ of $AX$ is
\[
(AX)_{i\bullet} = \sum_{j=1}^n a_{ij} \bx_j^T = \sum_{j \in \N(i)} \bx_j^T
\]
where $\N(i) = \{ j \in V : i \sim j \}$ is the neighbourhood of vertex $i$
\vfill
Using raw $A$ as our left-multiplier has \textbf{two structural flaws}:
\begin{enumerate}
\item \textbf{Forgetting a vertex's own features}: Because a simple graph has no self-loops ($a_{ii} = 0$), $(AX)_{i\bullet}$ sums the neighbours' features $\bx_j^T$ ($j \in \N(i)$) but \textbf{completely discards} vertex $i$'s own feature vector $\bx_i^T$!
\vfill
\item \textbf{Exploding/vanishing scales across vertex degrees}: A high-degree hub with $d_i = 1000$ sums $1000$ vectors, while a leaf vertex with $d_i = 1$ takes only $1$ vector. Across multiple layers, feature magnitudes explode at hubs!
\end{enumerate}
\end{frame}


\begin{frame}{Fix 1 and Fix 2: self-loops and degree normalisation}
We fix both flaws using standard graph matrix operations from Units 08 to 10:
\vfill
\begin{enumerate}
\item \textbf{Fix 1 -- Add self-loops to every vertex}:
Define the \defword{augmented adjacency matrix}
\[
\tilde{A} = A + \II_n \in \M_n
\]
Now $\tilde{a}_{ii} = 1$, so $(\tilde{A}X)_{i\bullet} = \bx_i^T + \sum_{j \in \N(i)} \bx_j^T$ includes vertex $i$ itself
\vfill
\item \textbf{Fix 2 -- Normalise by the augmented degree matrix}:
Let $D = \diag(d_1, \ldots, d_n)$ be the degree matrix of $G$, where $d_i = \sum_{j=1}^n a_{ij} = |\N(i)|$. The degree matrix of $\tilde{A}$ is the \defword{augmented degree matrix}
\[
\tilde{D} = D + \II_n = \diag(d_1 + 1, d_2 + 1, \ldots, d_n + 1) \in \M_n
\]
Since $d_i \ge 0$, $\tilde{d}_{ii} = d_i + 1 \ge 1 > 0$, so $\tilde{D}$ is \textbf{always invertible}, even if $G$ has isolated vertices!
\end{enumerate}
\end{frame}


\begin{frame}{Two canonical normalised graph smoothing operators}
Using $\tilde{A} = A + \II_n$ and $\tilde{D} = D + \II_n$, there are two standard choices for the smoothing operator $S \in \M_n$:
\vfill
\begin{definition}[Random-walk and symmetric normalised graph operators]
\label{def:gcn-operators}
\begin{enumerate}
\item \defword{Random-walk (row-normalised) propagation matrix}:
\[
S_{\text{rw}} = \tilde{D}^{-1} \tilde{A}, \qquad \big(S_{\text{rw}}\big)_{ij} = \frac{\tilde{a}_{ij}}{d_i + 1}
\]
Here $S_{\text{rw}}$ is \textbf{row-stochastic} ($S_{\text{rw}} \11_n = \11_n$) and row $i$ of $S_{\text{rw}} X$ is the \textbf{exact arithmetic average} of vertex $i$ and its neighbours:
\[
\big(\tilde{D}^{-1}\tilde{A} X\big)_{i\bullet} = \frac{1}{d_i + 1}\bx_i^T + \sum_{j \in \N(i)} \frac{1}{d_i + 1}\bx_j^T
\]
\item \defword{Symmetric normalised propagation matrix} (Kipf and Welling, 2017):
\[
S_{\text{sym}} = \tilde{D}^{-1/2} \tilde{A} \tilde{D}^{-1/2}, \qquad \big(S_{\text{sym}}\big)_{ij} = \frac{\tilde{a}_{ij}}{\sqrt{(d_i + 1)(d_j + 1)}}
\]
Here $S_{\text{sym}}$ is \textbf{symmetric} ($S_{\text{sym}}^T = S_{\text{sym}}$) with real eigenvalues in $[-1, 1]$
\end{enumerate}
\end{definition}
\end{frame}


\begin{frame}{The graph convolutional network (GCN) layer}
\begin{importantdefinition}[Graph convolutional network layer]
\label{def:gcn-layer}
Given a graph $G = (V, E)$ with augmented adjacency matrix $\tilde{A} = A + \II_n$, augmented degree matrix $\tilde{D} = D + \II_n$ and propagation operator $S \in \big\{\tilde{D}^{-1}\tilde{A},\; \tilde{D}^{-1/2}\tilde{A}\tilde{D}^{-1/2}\big\}$, an $L$-layer \defword{Graph Convolutional Network (GCN)} with layer widths $p_0, p_1, \ldots, p_L$ sets $H^{(0)} = X \in \M_{n, p_0}$ (where $p_0 = p$) and updates vertex representations at layer $\ell \in \{1, \ldots, L\}$ via
\[
H^{(\ell)} = \sigma_\ell\!\big(S H^{(\ell-1)} W^{(\ell)}\big) \in \M_{n, p_\ell}
\]
where $W^{(\ell)} \in \M_{p_{\ell-1}, p_\ell}$ is the trainable feature weight matrix of layer $\ell$ and $\sigma_\ell$ is a component-wise activation function
\end{importantdefinition}
\vfill
Notice that if the graph has \textbf{no edges} ($A = 0$), then $\tilde{A} = \tilde{D} = \II_n$, so $S = \II_n$ and the GCN layer reduces to a standard MLP layer $H^{(\ell)} = \sigma_\ell\big(H^{(\ell-1)} W^{(\ell)}\big)$!
\end{frame}


\begin{frame}{Multi-hop aggregation and over-smoothing (link to Markov chains)}
What happens as we stack $L$ GCN layers?
\begin{itemize}
\item In layer 1, vertex $i$ averages features from its $1$-hop neighbourhood $\N(i) \cup \{i\}$
\item In layer 2, vertex $i$ averages layer-1 features from its neighbours, which already contain information from \emph{their} neighbours -- aggregating the \textbf{$2$-hop neighbourhood}!
\item In a linear GCN ($\sigma_\ell = \text{id}$), $k$ layers compute $H^{(k)} = S_{\text{rw}}^k X W^{(1)} \cdots W^{(k)} = \big(\tilde{D}^{-1}\tilde{A}\big)^k X W$
\end{itemize}
\vfill
\textbf{Connection to Unit 08 (Markov chains) -- the over-smoothing phenomenon}:
\begin{itemize}
\item Because $S_{\text{rw}} = \tilde{D}^{-1}\tilde{A}$ is the transition matrix of a regular Markov chain on a connected graph (self-loops make it aperiodic!), as $k \to \infty$,
\[
\lim_{k \to \infty} \big(\tilde{D}^{-1}\tilde{A}\big)^k = \11_n \bm{\pi}^T \quad (\text{a rank-1 matrix}), \qquad \pi_j = \frac{d_j + 1}{\sum_{m=1}^n (d_m + 1)}
\]
\item Thus $\big(\tilde{D}^{-1}\tilde{A}\big)^k X \to \11_n (\bm{\pi}^T X)$: every row becomes \textbf{identical}, washing out all local differences between vertices! Hence GCNs in practice are kept shallow ($L = 2$ or $3$)
\end{itemize}
\end{frame}


\begin{frame}{Brief remark: Transformers and self-attention as dynamic graph operators}
In large language models (Transformers), a sequence of $n$ tokens is represented by a data matrix (token embedding matrix) $X \in \M_{np}$. A \defword{self-attention head} projects $X$ using three weight matrices $W_Q, W_K \in \M_{p, d_k}$ and $W_V \in \M_{p, d_v}$:
\[
Q = X W_Q, \qquad K = X W_K, \qquad V = X W_V
\]
and computes the output matrix
\[
\operatorname{Attention}(X) = \underbrace{\operatorname{softmax}\!\left(\frac{Q K^T}{\sqrt{d_k}}\right)}_{S(X) \in \M_n} X W_V
\]
where $\operatorname{softmax}$ is applied row-wise so every row of $S(X)$ is non-negative and sums to $1$
\vfill
\textbf{Linear algebra unification}: Self-attention is also a sandwich product $S(X) X W_V$! Instead of a fixed graph operator $S = \tilde{D}^{-1}\tilde{A}$, the row-stochastic matrix $S(X) \in \M_n$ is a \defword{learned, data-dependent adjacency matrix} computed dynamically from the pairwise inner products $Q K^T = X W_Q W_K^T X^T$
\end{frame}


\begin{frame}{Mini-example: self-attention as a row-stochastic left multiplier}
Consider a 2-token sequence (``river'', ``bank'') with $2 \times 2$ embedding matrix $X = \begin{pmatrix} 0.5 & 0.2 \\ 0.8 & 0.6 \end{pmatrix}$ and $W_Q = W_K = W_V = \II_2$ ($d_k = 2$), so $Q = K = V = X$:
\vfill
\begin{enumerate}
\item \textbf{Pairwise dot-product score matrix} $Q K^T = X X^T$:
\[
\frac{Q K^T}{\sqrt{2}} = \frac{1}{\sqrt{2}} \begin{pmatrix} 0.5 & 0.2 \\ 0.8 & 0.6 \end{pmatrix} \begin{pmatrix} 0.5 & 0.8 \\ 0.2 & 0.6 \end{pmatrix}
= \frac{1}{\sqrt{2}} \begin{pmatrix} 0.29 & 0.52 \\ 0.52 & 1.00 \end{pmatrix}
\approx \begin{pmatrix} 0.205 & 0.368 \\ 0.368 & 0.707 \end{pmatrix}
\]
\item \textbf{Row-wise softmax produces a $2 \times 2$ row-stochastic matrix $S(X)$}:
\[
S(X) = \operatorname{softmax}\!\left(\frac{Q K^T}{\sqrt{2}}\right) \approx \begin{pmatrix} 0.46 & 0.54 \\ 0.42 & 0.58 \end{pmatrix}
\]
\item \textbf{Left-multiplying $V = X$ forms convex combinations of token rows}:
\[
\bz_{\text{river}}^T = 0.46 \begin{pmatrix} 0.5 & 0.2 \end{pmatrix} + 0.54 \begin{pmatrix} 0.8 & 0.6 \end{pmatrix} = \begin{pmatrix} 0.662 & 0.416 \end{pmatrix}
\]
\end{enumerate}
\end{frame}


\begin{frame}{Example by hand: 1-layer GCN forward pass on a 3-vertex path}
\begin{columns}[c]
\begin{column}{0.64\textwidth}
\textbf{Problem:} Consider the 3-vertex path graph $1 - 2 - 3$ with vertex feature matrix $X \in \M_{32}$ and weight matrix $W \in \M_{22}$:
\[
X = \begin{pmatrix} 2 & 0 \\ 0 & 6 \\ 4 & 0 \end{pmatrix}, \qquad
W = \begin{pmatrix} 2 & -1 \\ -1 & 1 \end{pmatrix}
\]
Compute the 1-layer row-normalised ReLU GCN output
\[
H = \operatorname{ReLU}\!\big(\tilde{D}^{-1}\tilde{A} X W\big)
\]
by hand
\end{column}
\begin{column}{0.36\textwidth}
\centering
\begin{tikzpicture}[scale=1.0, >=Latex]
    \node[circle, draw, very thick, fill=blue!15, minimum size=0.9cm] (v1) at (0, 1.4) {$1$};
    \node[circle, draw, very thick, fill=yellow!25, minimum size=0.9cm] (v2) at (0, 0) {$2$};
    \node[circle, draw, very thick, fill=blue!15, minimum size=0.9cm] (v3) at (0, -1.4) {$3$};
    \draw[very thick] (v1) -- (v2);
    \draw[very thick] (v2) -- (v3);
    \node[right=0.25cm of v1, font=\footnotesize] {$\bx_1^T = (2, 0)$};
    \node[right=0.25cm of v2, font=\footnotesize] {$\bx_2^T = (0, 6)$};
    \node[right=0.25cm of v3, font=\footnotesize] {$\bx_3^T = (4, 0)$};
\end{tikzpicture}
\end{column}
\end{columns}
\end{frame}


\begin{frame}{Example by hand: step 1 -- graph matrices $A$, $\tilde{A}$, $\tilde{D}^{-1}$ and $S_{\text{rw}}$}
For the path graph $1 - 2 - 3$, the adjacency matrix $A$ and augmented adjacency matrix $\tilde{A} = A + \II_3$ are
\[
A = \begin{pmatrix} 0 & 1 & 0 \\ 1 & 0 & 1 \\ 0 & 1 & 0 \end{pmatrix}, \qquad
\tilde{A} = A + \II_3 = \begin{pmatrix} 1 & 1 & 0 \\ 1 & 1 & 1 \\ 0 & 1 & 1 \end{pmatrix}
\]
\vfill
The vertex degrees are $d_1 = 1$, $d_2 = 2$ and $d_3 = 1$, so $\tilde{D} = D + \II_3$, $\tilde{D}^{-1}$ and $S_{\text{rw}} = \tilde{D}^{-1}\tilde{A}$ are
\[
\tilde{D} = \begin{pmatrix} 2 & 0 & 0 \\ 0 & 3 & 0 \\ 0 & 0 & 2 \end{pmatrix}, \quad
\tilde{D}^{-1} = \begin{pmatrix} \frac{1}{2} & 0 & 0 \\ 0 & \frac{1}{3} & 0 \\ 0 & 0 & \frac{1}{2} \end{pmatrix}, \quad
S_{\text{rw}} = \tilde{D}^{-1}\tilde{A} =
\begin{pmatrix}
\frac{1}{2} & \frac{1}{2} & 0 \\[2pt]
\frac{1}{3} & \frac{1}{3} & \frac{1}{3} \\[2pt]
0 & \frac{1}{2} & \frac{1}{2}
\end{pmatrix}
\]
\end{frame}


\begin{frame}{Example by hand: step 2 -- left-multiplying $X$ and right-multiplying $W$}
\textbf{Neighbourhood feature averaging} (left-multiplication by $\tilde{D}^{-1}\tilde{A}$):
\[
\tilde{D}^{-1}\tilde{A} X =
\begin{pmatrix}
\frac{1}{2} & \frac{1}{2} & 0 \\[2pt]
\frac{1}{3} & \frac{1}{3} & \frac{1}{3} \\[2pt]
0 & \frac{1}{2} & \frac{1}{2}
\end{pmatrix}
\begin{pmatrix} 2 & 0 \\ 0 & 6 \\ 4 & 0 \end{pmatrix}
=
\begin{pmatrix} 1 & 3 \\ 2 & 2 \\ 2 & 3 \end{pmatrix}
\]
Notice how vertex 2 (which initially had feature $x_{21} = 0$) acquired a positive first feature $(2+0+4)/3 = 2$ from its neighbours 1 and 3!
\vfill
\textbf{Feature projection and ReLU activation} (right-multiplication by $W$, then $\max(0, \cdot)$):
\[
Z = \big(\tilde{D}^{-1}\tilde{A} X\big) W =
\begin{pmatrix} 1 & 3 \\ 2 & 2 \\ 2 & 3 \end{pmatrix}
\begin{pmatrix} 2 & -1 \\ -1 & 1 \end{pmatrix}
=
\begin{pmatrix} -1 & 2 \\ 2 & 0 \\ 1 & 1 \end{pmatrix}, \qquad
H = \operatorname{ReLU}(Z) =
\begin{pmatrix} 0 & 2 \\ 2 & 0 \\ 1 & 1 \end{pmatrix}
\]
\end{frame}


\begin{frame}[fragile]{Verification in R: 3-vertex GCN hand calculation}
<<gcn-hand-verify>>=
A = matrix(c(0, 1, 0,  1, 0, 1,  0, 1, 0), nrow = 3, byrow = TRUE)
A_tilde = A + diag(3)
S_rw = diag(1 / rowSums(A_tilde)) %*% A_tilde
X = matrix(c(2, 0,  0, 6,  4, 0), nrow = 3, byrow = TRUE)
W = matrix(c(2, -1,  -1, 1), nrow = 2, byrow = TRUE)
SX = S_rw %*% X;  Z = SX %*% W;  H = pmax(0, Z)
cbind(SX = SX, Z = Z, H = H)
@
\end{frame}


\begin{frame}[fragile]{R demonstration: 2-layer GCN on Zachary's Karate Club graph}
Kipf and Welling (2017) showed on Zachary's Karate Club network ($n = 34$ vertices in 2 factions) that \textbf{even with random untrained weights $W^{(1)}, W^{(2)}$}, a 2-layer GCN $H^{(2)} = \tanh\!\big(S_{\text{sym}}\, \tanh(S_{\text{sym}} X W^{(1)})\, W^{(2)}\big)$ with $X = \II_{34}$ separates the two communities in $\IR^2$:
<<karate-gcn>>=
G_karate = make_graph("Zachary")
A_k = as.matrix(as_adjacency_matrix(G_karate));  n_k = nrow(A_k)
A_tilde_k = A_k + diag(n_k)
D_inv_sqrt = diag(1 / sqrt(rowSums(A_tilde_k)))
S_sym = D_inv_sqrt %*% A_tilde_k %*% D_inv_sqrt
set.seed(42)
W1_k = matrix(rnorm(n_k * 8, sd = 0.6), n_k, 8)
W2_k = matrix(rnorm(8 * 2, sd = 0.6), 8, 2)
H1_k = tanh(S_sym %*% diag(n_k) %*% W1_k)
H2_k = tanh(S_sym %*% H1_k %*% W2_k)
@
\end{frame}


<<plot-karate-gcn,echo=FALSE,fig.width=8.5,fig.height=4.3>>=
# True faction membership (Mr Hi = 1 vs Officer John A = 34)
dist_1 = as.vector(distances(G_karate, v = 1))
dist_34 = as.vector(distances(G_karate, v = 34))
faction = ifelse(dist_1 < dist_34, 1, 2)
faction[c(1, 34)] = c(1, 2)
node_cols = ifelse(faction == 1, "dodgerblue3", "firebrick2")

par(mfrow = c(1, 2), mar = c(3.5, 3.5, 2.5, 1), mgp = c(2.1, 0.7, 0))
set.seed(123)
lay = layout_with_fr(G_karate)
plot(G_karate, layout = lay, vertex.color = node_cols, vertex.size = 15,
     vertex.label.color = "white", vertex.label.cex = 0.7,
     main = "Zachary's Karate Club graph (2 factions)")

plot(H2_k[, 1], H2_k[, 2], pch = 21, bg = node_cols, col = "black", cex = 2.2,
     xlab = expression(H[i1]^{(2)}), ylab = expression(H[i2]^{(2)}),
     main = "2-layer GCN embedding in R^2 (untrained W)")
text(H2_k[, 1], H2_k[, 2], labels = 1:n_k, cex = 0.55, col = "white", font = 2)
legend("bottomleft", legend = c("Faction 1 (Mr Hi)", "Faction 2 (Officer)"),
       pt.bg = c("dodgerblue3", "firebrick2"), pch = 21, pt.cex = 1.5, bty = "n", cex = 0.85)
@

\maxFrameImage{\Sexpr{knitr::fig_chunk("plot-karate-gcn", "pdf")}}


\begin{frame}[fragile]{R demonstration: visualising Markov chain over-smoothing as $k$ grows}
Applying $S_{\text{rw}} = \tilde{D}^{-1}\tilde{A}$ for $k = 1, 5, 50$ steps to initial 2D features $X_0 \in \M_{34, 2}$ converges to the rank-1 stationary average $\11_n(\bm{\pi}^T X_0)$:
<<karate-oversmoothing>>=
S_rw_k = diag(1 / rowSums(A_tilde_k)) %*% A_tilde_k;  set.seed(7)
X0_k = cbind(ifelse(faction == 1, -1, 1) + rnorm(n_k, sd = 0.4),
             rnorm(n_k, sd = 0.6))
mat_pow = function(M, k) Reduce(`%*%`, replicate(k, M, simplify = FALSE))
X_step1  = S_rw_k %*% X0_k;  X_step5 = mat_pow(S_rw_k, 5) %*% X0_k
X_step50 = mat_pow(S_rw_k, 50) %*% X0_k
pi_stat = rowSums(A_tilde_k) / sum(A_tilde_k)
rbind(Row1_k50 = X_step50[1, ], Stat_avg = as.vector(t(pi_stat) %*% X0_k))
@
\end{frame}


<<plot-karate-oversmoothing,echo=FALSE,fig.width=9,fig.height=3.6>>=
par(mfrow = c(1, 3), mar = c(3.8, 3.8, 2.5, 0.8), mgp = c(2.1, 0.7, 0))
xlim_os = range(X0_k[, 1])
ylim_os = range(X0_k[, 2])
stat_pt = as.vector(t(pi_stat) %*% X0_k)

plot(X_step1[, 1], X_step1[, 2], pch = 21, bg = node_cols, cex = 1.8,
     xlim = xlim_os, ylim = ylim_os, xlab = "Feature 1", ylab = "Feature 2",
     main = "k = 1 layer (local smoothing)")
points(stat_pt[1], stat_pt[2], pch = 4, cex = 2, lwd = 2.5, col = "black")

plot(X_step5[, 1], X_step5[, 2], pch = 21, bg = node_cols, cex = 1.8,
     xlim = xlim_os, ylim = ylim_os, xlab = "Feature 1", ylab = "Feature 2",
     main = "k = 5 layers (communities separated)")
points(stat_pt[1], stat_pt[2], pch = 4, cex = 2, lwd = 2.5, col = "black")

plot(X_step50[, 1], X_step50[, 2], pch = 21, bg = node_cols, cex = 1.8,
     xlim = xlim_os, ylim = ylim_os, xlab = "Feature 1", ylab = "Feature 2",
     main = "k = 50 layers (over-smoothed collapse!)")
points(stat_pt[1], stat_pt[2], pch = 4, cex = 2, lwd = 2.5, col = "black")
legend("topright", legend = c("Faction 1", "Faction 2", expression(pi^T * X[0])),
       pt.bg = c("dodgerblue3", "firebrick2", NA), col = c("black", "black", "black"),
       pch = c(21, 21, 4), pt.cex = 1.3, bty = "n", cex = 0.85)
@

\maxFrameImage{\Sexpr{knitr::fig_chunk("plot-karate-oversmoothing", "pdf")}}


\begin{frame}{Summary: neural networks through the lens of linear algebra}
\begin{center}
{\footnotesize
\renewcommand{\arraystretch}{1.35}
\begin{tabular}{lll}
\toprule
\textbf{Architecture} & \textbf{Layer operator on $X \in \M_{np}$} & \textbf{Core linear algebra mechanism} \\
\midrule
Single neuron & $\sigma\big(X\bw + b\11_n\big)$ & Affine hyperplane $\bw^T\bx + b = 0$ (Unit 06) \\
MLP layer & $\sigma\big(X W^T + \11_n \bb^T\big)$ & Right-multiplication + rank-1 bias broadcast \\
Deep linear net & $X \big(W^{(L)}\cdots W^{(1)}\big)^T + \11_n \bb^T$ & Collapses to 1 matrix; $\rank(W) \le \min_\ell p_\ell$ \\
Linear autoencoder & $\hat{X} = \widetilde{X} W_1 W_2 \;\; (k < p)$ & Optimal $W_1 W_2 = V_k V_k^T$ is PCA (Units 04--05) \\
GCN layer & $\sigma\big(\tilde{D}^{-1}\tilde{A} X W\big)$ & Left graph smoothing $\times$ right feature projection \\
Self-attention & $\operatorname{softmax}\!\big(\frac{XW_QW_K^TX^T}{\sqrt{d_k}}\big) X W_V$ & Data-dependent row-stochastic left multiplier \\
\bottomrule
\end{tabular}
}
\end{center}
\vfill
Modern deep learning architectures are built by composing the exact matrix factorisations, subspace projections and spectral graph operators developed throughout MATH 2740
\end{frame}


