\SSsection{From single neurons to affine matrix layers}

%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%
\SSsubsection{Single artificial neuron and the perceptron}

\begin{frame}{Biological inspiration and the McCulloch-Pitts-Rosenblatt neuron}
\begin{quote}
\textbf{Artificial neural networks} (ANNs) are computing systems inspired by biological neural networks. A collection of connected nodes called \textbf{artificial neurons} receive real-valued signals along weighted edges (\emph{synapses}), aggregate them via an affine combination and emit an output through a non-linear \textbf{activation function}
\end{quote}
\vfill
\begin{itemize}
\item McCulloch and Pitts (1943) introduced threshold logic units for Boolean computation
\vfill
\item Rosenblatt (1957) introduced the \defword{perceptron} for pattern classification (such as recognising letters or digits from a pixel grid called the \emph{retina})
\vfill
\item Mathematically, a single artificial neuron is a direct generalisation of the linear classifiers and separating hyperplanes studied in Unit 06
\end{itemize}
\end{frame}


\begin{frame}{The single artificial neuron as an affine functional}
\begin{importantdefinition}[Single artificial neuron]
\label{def:single-neuron}
Given an input feature vector $\bx = (x_1, \ldots, x_p)^T \in \IR^p$, a \defword{single artificial neuron} is parameterised by a \defword{weight vector} $\bw = (w_1, \ldots, w_p)^T \in \IR^p$ and a scalar \defword{bias} $b \in \IR$. It computes:
\begin{enumerate}
\item An \defword{affine pre-activation} (or \defword{logit}):
\[
z = \bw^T \bx + b = \sum_{j=1}^p w_j x_j + b \in \IR
\]
\item A scalar \defword{activation} (output):
\[
a = \sigma(z) = \sigma\big(\bw^T \bx + b\big) \in \IR
\]
where $\sigma: \IR \to \IR$ is a chosen \defword{activation function}
\end{enumerate}
\end{importantdefinition}
\end{frame}


\begin{frame}{Absorbing the bias via augmented coordinates}
In classical perceptron notation, a threshold $\theta$ is used so the neuron fires when $\bw^T \bx > \theta$; setting $b = -\theta$ gives $\bw^T \bx + b > 0$
\vfill
Just as in homogeneous coordinates, we can absorb the bias $b$ into the weight vector by introducing a constant ``dummy'' input feature $x_0 = 1$:
\[
\hat{\bx} = \begin{pmatrix} \bx \\ 1 \end{pmatrix} = \begin{pmatrix} x_1 \\ \vdots \\ x_p \\ 1 \end{pmatrix} \in \IR^{p+1}, \qquad
\hat{\bw} = \begin{pmatrix} \bw \\ b \end{pmatrix} = \begin{pmatrix} w_1 \\ \vdots \\ w_p \\ b \end{pmatrix} \in \IR^{p+1}
\]
\vfill
Then the affine pre-activation becomes a pure inner product in $\IR^{p+1}$:
\[
z = \bw^T \bx + b = \hat{\bw}^T \hat{\bx}
\]
\end{frame}


\begin{frame}{Diagram of a single neuron with augmented bias input}
\begin{center}
\begin{tikzpicture}[scale=0.88, every node/.style={transform shape}, >=Latex]
    \node[cloud, fill=blue!15, minimum width=1.4cm] (x1) at (0, 2.4) {$x_1$};
    \node[cloud, fill=blue!15, minimum width=1.4cm] (x2) at (0, 1.0) {$x_2$};
    \node at (0, 0.1) {$\vdots$};
    \node[cloud, fill=blue!15, minimum width=1.4cm] (xd) at (0, -0.8) {$x_p$};
    \node[cloud, fill=orange!25, minimum width=1.4cm] (x0) at (0, -2.2) {$1$};

    \node[draw, circle, thick, fill=yellow!20, minimum size=1.8cm] (sum) at (5.2, 0.2) {$z = \hat{\bw}^T\hat{\bx}$};
    \node[draw, rectangle, rounded corners, thick, fill=red!15, minimum width=1.8cm, minimum height=1.2cm] (act) at (9.0, 0.2) {$\sigma(z)$};
    \node (out) at (11.8, 0.2) {$a = \sigma(\bw^T\bx + b)$};

    \draw[->, thick] (x1) -- node[midway, above, sloped] {$w_1$} (sum);
    \draw[->, thick] (x2) -- node[midway, above, sloped] {$w_2$} (sum);
    \draw[->, thick] (xd) -- node[midway, above, sloped] {$w_p$} (sum);
    \draw[->, thick, orange!80!black] (x0) -- node[midway, below, sloped] {$b$ (bias)} (sum);
    \draw[->, very thick] (sum) -- node[midway, above] {$z$} (act);
    \draw[->, very thick] (act) -- (out);
\end{tikzpicture}
\end{center}
\vfill
Geometrically, the locus $\{ \bx \in \IR^p : \bw^T \bx + b = 0 \}$ is an \defword{affine hyperplane} with normal vector $\bw$, partitioning $\IR^p$ into two half-spaces $\{ \bw^T \bx + b > 0 \}$ and $\{ \bw^T \bx + b < 0 \}$
\end{frame}


\begin{frame}{Common scalar activation functions}
\begin{definition}[Component-wise activation functions]
When applied to a vector $\bz \in \IR^p$ or matrix $Z \in \M_{np}$, a scalar activation function $\sigma: \IR \to \IR$ acts \defword{entrywise}: $\big[\sigma(Z)\big]_{ij} = \sigma(z_{ij})$. Standard choices include:
\begin{itemize}
\item \defword{Heaviside step (threshold)}: $H(z) = \begin{cases} 0 & \text{if } z \le 0 \\ 1 & \text{if } z > 0 \end{cases}$
\item \defword{Rectified linear unit (ReLU)}: $\operatorname{ReLU}(z) = \max(0, z) = \begin{cases} 0 & \text{if } z \le 0 \\ z & \text{if } z > 0 \end{cases}$
\item \defword{Logistic sigmoid}: $\sigma_{\text{sig}}(z) = \dfrac{1}{1 + e^{-z}} \in (0, 1)$
\item \defword{Hyperbolic tangent}: $\tanh(z) = \dfrac{e^z - e^{-z}}{e^z + e^{-z}} = 2\sigma_{\text{sig}}(2z) - 1 \in (-1, 1)$
\end{itemize}
\end{definition}
\end{frame}


<<plot-activations,echo=FALSE,fig.width=8,fig.height=4.5>>=
z_vals = seq(-4, 4, length.out = 500)
par(mfrow = c(2, 2), mar = c(3.5, 3.5, 2.2, 1), mgp = c(2, 0.7, 0))

# Step
plot(z_vals, ifelse(z_vals > 0, 1, 0), type = "l", lwd = 3, col = "dodgerblue4",
     xlab = "z", ylab = expression(sigma(z)), main = "Heaviside step", ylim = c(-0.2, 1.2))
abline(h = 0, v = 0, col = "gray70", lty = 2)

# ReLU
plot(z_vals, pmax(0, z_vals), type = "l", lwd = 3, col = "firebrick",
     xlab = "z", ylab = expression(sigma(z)), main = "ReLU: max(0, z)", ylim = c(-0.5, 4))
abline(h = 0, v = 0, col = "gray70", lty = 2)

# Sigmoid
plot(z_vals, 1 / (1 + exp(-z_vals)), type = "l", lwd = 3, col = "darkgreen",
     xlab = "z", ylab = expression(sigma(z)), main = "Logistic sigmoid", ylim = c(-0.2, 1.2))
abline(h = c(0, 0.5, 1), v = 0, col = "gray70", lty = 2)

# Tanh
plot(z_vals, tanh(z_vals), type = "l", lwd = 3, col = "purple4",
     xlab = "z", ylab = expression(sigma(z)), main = "Hyperbolic tangent: tanh(z)", ylim = c(-1.2, 1.2))
abline(h = c(-1, 0, 1), v = 0, col = "gray70", lty = 2)
@

\maxFrameImage{\Sexpr{knitr::fig_chunk("plot-activations", "pdf")}}


\begin{frame}{Single-layer perceptrons on Boolean logic gates: OR and AND}
Consider binary inputs $\bx = (x_1, x_2)^T \in \{0, 1\}^2$ with the Heaviside step activation $H(z)$
\vfill
\begin{columns}[t]
\begin{column}{0.48\textwidth}
\textbf{Logical OR gate}:
\begin{center}
\begin{tabular}{cc|c|c}
\toprule
$x_1$ & $x_2$ & $z = x_1 + x_2 - 0.5$ & $H(z)$ \\
\midrule
0 & 0 & $-0.5$ & 0 \\
1 & 0 & $+0.5$ & 1 \\
0 & 1 & $+0.5$ & 1 \\
1 & 1 & $+1.5$ & 1 \\
\bottomrule
\end{tabular}
\end{center}
Solved by $\bw = (1, 1)^T$ and $b = -0.5$
\end{column}
\begin{column}{0.48\textwidth}
\textbf{Logical AND gate}:
\begin{center}
\begin{tabular}{cc|c|c}
\toprule
$x_1$ & $x_2$ & $z = x_1 + x_2 - 1.5$ & $H(z)$ \\
\midrule
0 & 0 & $-1.5$ & 0 \\
1 & 0 & $-0.5$ & 0 \\
0 & 1 & $-0.5$ & 0 \\
1 & 1 & $+0.5$ & 1 \\
\bottomrule
\end{tabular}
\end{center}
Solved by $\bw = (1, 1)^T$ and $b = -1.5$
\end{column}
\end{columns}
\vfill
In both cases, a single line $x_1 + x_2 + b = 0$ separates the class-$0$ points from the class-$1$ points in $\IR^2$
\end{frame}


\begin{frame}{The perceptron and Widrow-Hoff learning rule in vector form}
How does a single neuron learn its augmented weight vector $\hat{\bw} = (\bw^T, b)^T \in \IR^{p+1}$ from labelled training pairs $\big\{(\bx_i, y_i)\big\}_{i=1}^n$ with $y_i \in \{0, 1\}$?
\vfill
In \defword{supervised error-correction learning} (Widrow-Hoff / delta rule), when input $\hat{\bx}_i = (\bx_i^T, 1)^T$ produces output $\hat{y}_i = H\big((\hat{\bw}^{(t)})^T \hat{\bx}_i\big)$, we update the weight vector by
\[
\hat{\bw}^{(t+1)} = \hat{\bw}^{(t)} + \eta \big(y_i - \hat{y}_i\big) \hat{\bx}_i
\]
where $\eta > 0$ is the \defword{learning rate}
\vfill
\textbf{Geometric meaning via inner products}:
\begin{itemize}
\item If $\hat{y}_i = y_i$ (correct prediction), $\hat{\bw}^{(t+1)} = \hat{\bw}^{(t)}$ (no change)
\item If $y_i = 1$ but $\hat{y}_i = 0$ (false negative), $\hat{\bw}^{(t+1)} = \hat{\bw}^{(t)} + \eta \hat{\bx}_i$, so the new pre-activation on $\hat{\bx}_i$ strictly increases:
\[
\big(\hat{\bw}^{(t+1)}\big)^T \hat{\bx}_i = \big(\hat{\bw}^{(t)}\big)^T \hat{\bx}_i + \eta \|\hat{\bx}_i\|_2^2 > \big(\hat{\bw}^{(t)}\big)^T \hat{\bx}_i
\]
tilting the hyperplane normal $\hat{\bw}$ towards $\hat{\bx}_i$!
\end{itemize}
\end{frame}


\begin{frame}{Worked trace: two perceptron updates to learn OR}
Let us trace the update rule $\hat{\bw}^{(t+1)} = \hat{\bw}^{(t)} + \eta(y_i - \hat{y}_i)\hat{\bx}_i$ with $\eta = 0.1$ and augmented inputs $\hat{\bx} = (x_1, x_2, 1)^T$, starting from $\hat{\bw}^{(0)} = (0, 0, 0)^T$:
\vfill
\begin{enumerate}
\item \textbf{Step 1}: Present $\bx = (1, 1)^T$, so $\hat{\bx} = (1, 1, 1)^T$ with target $y = 1$. Since $\big(\hat{\bw}^{(0)}\big)^T \hat{\bx} = 0 \le 0$, we predict $\hat{y} = 0$ (error $y - \hat{y} = 1$):
\[
\hat{\bw}^{(1)} = \begin{pmatrix} 0 \\ 0 \\ 0 \end{pmatrix} + 0.1 (1 - 0) \begin{pmatrix} 1 \\ 1 \\ 1 \end{pmatrix} = \begin{pmatrix} 0.1 \\ 0.1 \\ 0.1 \end{pmatrix}
\]
\vfill
\item \textbf{Step 2}: Present $\bx = (0, 0)^T$, so $\hat{\bx} = (0, 0, 1)^T$ with target $y = 0$. Since $\big(\hat{\bw}^{(1)}\big)^T \hat{\bx} = 0.1 > 0$, we predict $\hat{y} = 1$ (error $y - \hat{y} = -1$):
\[
\hat{\bw}^{(2)} = \begin{pmatrix} 0.1 \\ 0.1 \\ 0.1 \end{pmatrix} + 0.1 (0 - 1) \begin{pmatrix} 0 \\ 0 \\ 1 \end{pmatrix} = \begin{pmatrix} 0.1 \\ 0.1 \\ 0 \end{pmatrix}
\]
\end{enumerate}
\vfill
With $\bw = (0.1, 0.1)^T$ and $b = 0$, $H(0.1 x_1 + 0.1 x_2)$ classifies all four OR inputs correctly!
\end{frame}


\begin{frame}{Why a single neuron fails on XOR (Minsky and Papert, 1969)}
Now consider the \defword{exclusive OR (XOR)} truth table on $\{0, 1\}^2$:
\[
(0,0) \mapsto 0, \qquad (1,0) \mapsto 1, \qquad (0,1) \mapsto 1, \qquad (1,1) \mapsto 0
\]
\vfill
Suppose a single neuron with weights $\bw = (w_1, w_2)^T$ and bias $b$ could represent XOR via $H(\bw^T \bx + b)$. Then the four inputs require:
\begin{align*}
(0,0) \mapsto 0 &\implies b \le 0 \\
(1,0) \mapsto 1 &\implies w_1 + b > 0 \\
(0,1) \mapsto 1 &\implies w_2 + b > 0 \\
(1,1) \mapsto 0 &\implies w_1 + w_2 + b \le 0
\end{align*}
\vfill
Adding the second and third inequalities gives $w_1 + w_2 + 2b > 0$. Since $b \le 0$, this implies $w_1 + w_2 + b \ge w_1 + w_2 + 2b > 0$, contradicting $w_1 + w_2 + b \le 0$!
\end{frame}


\begin{frame}{Linear separability: OR vs XOR in $\IR^2$}
\begin{center}
\begin{tikzpicture}[scale=2.6, auto, >=Latex]
    \draw[step=1cm, gray!25, very thin] (-0.3,-0.3) grid (1.4,1.4);
    \draw[thick, ->] (-0.3,0) -- (1.5,0) node[right] {$x_1$};
    \draw[thick, ->] (0,-0.3) -- (0,1.5) node[above] {$x_2$};
    \draw[very thick, red!80!black, dashed] (-0.2, 0.7) -- (0.7, -0.2) node[right, font=\footnotesize] {$x_1+x_2=0.5$};
    \node[circle, draw, very thick, fill=white, inner sep=2.5pt] at (0,0) {};
    \fill[blue!80!black] (1,0) circle[radius=2.5pt];
    \fill[blue!80!black] (0,1) circle[radius=2.5pt];
    \fill[blue!80!black] (1,1) circle[radius=2.5pt];
    \node[font=\bfseries\small] at (0.5, -0.45) {OR: linearly separable};
\end{tikzpicture}
\hspace{1.2cm}
\begin{tikzpicture}[scale=2.6, auto, >=Latex]
    \draw[step=1cm, gray!25, very thin] (-0.3,-0.3) grid (1.4,1.4);
    \draw[thick, ->] (-0.3,0) -- (1.5,0) node[right] {$x_1$};
    \draw[thick, ->] (0,-0.3) -- (0,1.5) node[above] {$x_2$};
    \node[circle, draw, very thick, fill=white, inner sep=2.5pt] at (0,0) {};
    \fill[blue!80!black] (1,0) circle[radius=2.5pt];
    \fill[blue!80!black] (0,1) circle[radius=2.5pt];
    \node[circle, draw, very thick, fill=white, inner sep=2.5pt] at (1,1) {};
    \node[font=\bfseries\small, text=red!80!black] at (0.5, -0.45) {XOR: not linearly separable};
\end{tikzpicture}
\end{center}
\vfill
To solve non-linearly separable problems, we must \defword{compose} multiple layers: a hidden layer first maps the inputs into a new coordinate space where they become linearly separable
\end{frame}


